    "dexie": "^4.0.11",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "lz-string": "^1.5.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
